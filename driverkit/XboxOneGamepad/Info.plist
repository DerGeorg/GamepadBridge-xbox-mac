<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for the XboxOneGamepad DriverKit extension (TEMPLATE).

  Replace TEAMID and the bundle identifiers with your own. A virtual driver
  that matches no physical hardware is started by matching on IOUserResources
  (the standard pattern for "rootless" DriverKit drivers). The host app
  activates the extension; the userspace driver then opens it by service name.

  See ../README.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>at.dergeorg.xboxdonglemac.XboxOneGamepad</string>
    <key>CFBundleName</key>
    <string>XboxOneGamepad</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>DEXT</string>
    <key>OSBundleUsageDescription</key>
    <string>Provides a virtual Xbox gamepad fed by the Xbox Wireless Adapter.</string>

    <key>IOKitPersonalities</key>
    <dict>
        <key>XboxOneGamepad</key>
        <dict>
            <key>CFBundleIdentifierKernel</key>
            <string>com.apple.kpi.iokit</string>
            <key>IOClass</key>
            <string>IOUserService</string>
            <key>IOUserClass</key>
            <string>XboxOneGamepadDriver</string>
            <!-- DriverKit server name = the dext bundle id -->
            <key>IOUserServerName</key>
            <string>at.dergeorg.xboxdonglemac.XboxOneGamepad</string>
            <!-- Virtual driver: match the IOUserResources provider -->
            <key>IOProviderClass</key>
            <string>IOUserResources</string>
            <key>IOResourceMatch</key>
            <string>IOKit</string>
        </dict>
    </dict>
</dict>
</plist>
