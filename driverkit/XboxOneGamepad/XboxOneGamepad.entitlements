<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the DEXT (TEMPLATE).

  These are MANAGED entitlements: they must appear on a provisioning profile
  issued by Apple for your App ID / Team. com.apple.developer.driverkit and
  the HID-transport entitlement require Apple approval of a DriverKit request
  (https://developer.apple.com/contact/request/system-extension/). This is
  the main gate on shipping a virtual HID device — see ../README.md.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.driverkit</key>
    <true/>
    <key>com.apple.developer.driverkit.family.hid.device</key>
    <true/>
    <key>com.apple.developer.driverkit.family.hid.eventservice</key>
    <true/>
    <key>com.apple.developer.driverkit.transport.hid</key>
    <true/>
</dict>
</plist>
